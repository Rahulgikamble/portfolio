MONGO_URI=your_mongodb_atlas_connection_string_here
JWT_SECRET=any_long_random_secret_string
PORT=5001

# used once by "npm run seed:admin" to create your one and only admin login
ADMIN_NAME=Rahul Kamble
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose_a_strong_password

# optional: enables real email notifications when someone submits the
# contact form, via Resend (free, no domain setup needed to get started).
# Get a key at https://resend.com — free sign up, then Dashboard > API Keys.
RESEND_API_KEY=paste_your_resend_key_here
EMAIL_TO=you@gmail.com
